# Ignore binary ZIM files and downloaded archives
*.zim
zim_downloads/
*.zim_title.idx
*.zim_title.idx.tmp/

# Security & Privacy: Exclude personal SD card folders, archives & credentials
off-grid-agent/
*.env
*.key
*.pem
*.pfx
*.cert
credentials.json
secrets.json
config.json

# Local Python & Vector DBs
*.db
*.sqlite
*.sqlite3
__pycache__/
.venv/
*.log

# Ignore large downloaded PDFs and raw media
content/pdfs/*.pdf
natgeo_collection/pdfs/*.pdf
natgeo_collection/pdfs_original/
test_compress.pdf
*.zip
*.mp4

# OS / IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
